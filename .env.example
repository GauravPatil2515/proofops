# ProofOps Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PROOFOPS_PORT=8000
PROOFOPS_DEV_MODE=1

# Database
# For development: SQLite (default)
DATABASE_URL=sqlite:///proofops.db
# For production: PostgreSQL
# DATABASE_URL=postgresql://proofops:password@postgres:5432/proofops

# Switch Core Gateway
# Set to your Switch Core instance URL
SWITCH_BASE_URL=http://localhost:8080
# Bearer token for Switch API authentication
SWITCH_AUTH_TOKEN=

# Sentry Integration
SENTRY_WEBHOOK_SECRET=your-sentry-webhook-secret

# GitHub App Integration
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITHUB_APP_ID=your-github-app-id
GITHUB_PRIVATE_KEY_PATH=/app/secrets/github-private-key.pem

# Cryptographic Signing
# For production: Use KMS/HSM or set PROOFOPS_SIGNING_KEY to a base64-encoded Ed25519 private key
# For development: Keys are auto-generated in verification/.keys/
PROOFOPS_SIGNING_KEY=

# Logging
LOG_LEVEL=INFO